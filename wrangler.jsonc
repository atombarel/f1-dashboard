{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Same domain as the previous API worker; this Worker now serves both the site and /api.
  // Custom domain is also what enables the Cache API (it is a no-op on *.workers.dev).
  "routes": [{ "pattern": "f1-api.edge-mega.com", "custom_domain": true }],

  // The SPA is served from static assets; only /api/* hits the Worker first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "OPENF1_BASE": "https://api.openf1.org/v1",
    "JOLPICA_BASE": "https://api.jolpi.ca/ergast/f1",
    // Oldest season OpenF1 covers; backfill never goes further back.
    "FIRST_SEASON": "2023"
  },

  "d1_databases": [
    // Reuses the database of the previous version; the old cache tables are simply ignored.
    { "binding": "DB", "database_name": "f1-api-cache-db", "database_id": "6987f960-070c-4d07-b6ed-1cbdf937e7f0", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BUNDLES", "bucket_name": "f1-bundles" }],

  // Global rate limiter in front of every upstream call (OpenF1 caps at 3 req/s).
  "durable_objects": {
    "bindings": [{ "name": "GATE", "class_name": "UpstreamGate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UpstreamGate"] }],

  "workflows": [
    { "name": "f1-ingest-session", "binding": "INGEST", "class_name": "IngestSessionWorkflow" },
    { "name": "f1-ingest-meeting", "binding": "INGEST_MEETING", "class_name": "IngestMeetingWorkflow" }
  ],

  "triggers": {
    // Calendar sync + ingestion of freshly finished sessions, and a nightly backfill/standings pass.
    "crons": ["*/10 * * * *", "30 4 * * *"]
  }
}
